# Environment variables template - copy to .env (never commit .env)

# ---- Server ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ---- Security ----
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Supabase PostgreSQL connection string for development/demo
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp Business Cloud API ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- Email (optional, for notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ---- Object storage (optional, for private tenant documents) ----
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ---- Queues / cache (optional; app falls back to Postgres-backed queue) ----
REDIS_URL=
